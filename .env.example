# ============================================================================
# rtp 运行时配置模板：复制为 .env 后填写
#   cp .env.example .env
# ============================================================================

# ---------- 模型网关（OpenAI 兼容）----------
# 任何 OpenAI 兼容端点均可：本地反代、OneAPI、官方 API 等
LLM_BASE_URL=https://api.example.com/v1

# 必填。留空则系统自动降级为 mock 模式（离线可跑，但产出数据仅供演示）
LLM_API_KEY=请替换为你自己的密钥

# ---------- 三级模型路由 ----------
# 靶标侧：需要真实反映被攻击风险，建议用能力较强的模型
TIER_TARGET__MODEL=your-target-model
# 攻击侧：生成与编排质量直接决定绕过能力
TIER_ATTACK__MODEL=your-attack-model
# 判定侧：结构化判定任务，可用轻量模型压成本
TIER_JUDGE__MODEL=your-judge-model

# ---------- 运行模式 ----------
# auto：有 key 走真实调用，无 key 自动 mock
# on  ：强制 mock；off：强制真实调用（无 key 报错）
MOCK_MODE=auto

# 并发与限流（按上游配额调整，过高会触发 429 且整批记 error）
CONCURRENCY=3
REQUEST_INTERVAL=0.2

# ---------- 数据库 ----------
# 论文/正式实验建议独立库，与 mock 演示数据隔离：
#   DB_NAME=rtp_real.db
# 切换后先执行 python scripts/init_db.py --reset
